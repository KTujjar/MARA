FROM python:3.12-slim

# uv ships as a static binary — copying it in is faster and more reliable
# than pip-installing it as a Python package first.
COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /uvx /bin/

WORKDIR /app

# Copy dependency files first so this layer is cached and doesn't get
# reinstalled every time application code changes.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project

COPY . .
RUN uv sync --frozen

EXPOSE 8000

# --host 0.0.0.0 is required here, not optional. Uvicorn's default
# (127.0.0.1) only accepts connections from inside the container's own
# network namespace — the host machine's browser would get connection
# refused even with the port published, since 127.0.0.1 means something
# different inside vs. outside the container.
CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
